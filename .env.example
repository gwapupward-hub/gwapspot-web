# Clerk keys must come from the same Clerk instance.
# Use test keys for local/preview and live keys for Vercel Production.
# Never commit a real secret key.
CLERK_SECRET_KEY=

# The browser key is intentionally public, but it must match CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# GWAPSpot uses Clerk's direct Frontend API connection. Do not set
# NEXT_PUBLIC_CLERK_PROXY_URL unless proxying is intentionally configured in
# both the Clerk Dashboard and this codebase.
