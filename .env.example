# Privy application credentials. Use separate Privy apps for local/preview and
# production. Never expose PRIVY_APP_SECRET to the browser or commit real values.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# Use a dedicated production RPC endpoint to avoid public mainnet rate limits.
# SOLANA_RPC_URL is preferred by server-side Wallet Intelligence. The public
# value remains the browser fallback for existing client-side Solana features.
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only Jupiter key for Wallet Intelligence token metadata and Price V3
# portfolio valuation. Never expose this key through NEXT_PUBLIC_* variables.
JUPITER_API_KEY=

# GNS identity service. GNS_API_URL is server-only; never expose private service
# credentials here. The public profile base is intentionally browser-visible.
GNS_API_URL=https://gns-backend-zh4o.onrender.com/api
NEXT_PUBLIC_GNS_PROFILE_BASE_URL=https://gwapspot.fun

# GNS registrations currently settle on Solana devnet. This browser-visible RPC
# must target the same cluster returned by the GNS config endpoint.
NEXT_PUBLIC_GNS_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-side deployment pins prevent a compromised or drifting config endpoint
# from swapping the public program or treasury addresses used by wallet transactions.
GNS_EXPECTED_PROGRAM_ID=6cDCrNYmasd1qmnvdLf8jyt9iFa3jW9VLzJhrb7X7SEH
GNS_EXPECTED_TREASURY_PUBKEY=5K2NUTEaWUmCgXzS5giBtEb11uaPqGW5h1QKDmifFcjy
GNS_EXPECTED_NETWORK=devnet

# GwapScore Proof-of-Control — GWAP Public Proof.
# Public Proof verifies a pasted public X post through X API v2. Keep the
# explicit activation switch false until the production X app/Bearer Token is
# configured. The server fetches the Post by ID, confirms the exact GWAP
# challenge, checks the author username, and binds the stable X author ID.
GWAPSCORE_SOCIAL_VERIFIER_ENABLED=false
GWAPSCORE_X_BEARER_TOKEN=
GWAPSCORE_X_OFFICIAL_HANDLE=_GwapSpot

# Reserved for a future private/DM Proof-of-Control adapter. It is not used by
# the initial Public Proof flow.
GWAPSCORE_SOCIAL_VERIFICATION_WEBHOOK_SECRET=

# Approved Public Proof campaign art. These browser-visible URLs should point
# to the six 1536x768 GWAP share images. If omitted, the verification link uses
# the built-in generated fallback social card for that color.
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_GREEN_IMAGE_URL=
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_RED_IMAGE_URL=
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_BLUE_IMAGE_URL=
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_PURPLE_IMAGE_URL=
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_SILVER_IMAGE_URL=
NEXT_PUBLIC_GWAP_PUBLIC_PROOF_ORANGE_IMAGE_URL=

# Daily Ideas AI. OPENAI_API_KEY is preferred; ANTHROPIC_API_KEY remains a
# backward-compatible fallback. DAILY_IDEAS_MODEL optionally overrides the
# selected provider's pinned default model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DAILY_IDEAS_MODEL=gpt-5.6-terra

# Dedicated server-to-server credential for the versioned Daily Ideas Telegram
# identity API. Set the same 32+ character value on GWAP OS and DailyIdeas.
# Keep this server-only and never expose it through NEXT_PUBLIC_* variables.
DAILY_IDEAS_INTERNAL_API_KEY=

# Daily Ideas Telegram bot + native Mini App. Prefer the dedicated names below.
# The app remains backward-compatible with legacy TELEGRAM_BOT_TOKEN and generic
# TELEGRAM_WEBHOOK_SECRET values from the original DailyIdeas service.
DAILY_IDEAS_TELEGRAM_BOT_TOKEN=
DAILY_IDEAS_TELEGRAM_WEBHOOK_SECRET=
DAILY_IDEAS_TELEGRAM_APP_URL=https://www.gwapspot.com/telegram
# Used only to build the non-Telegram fallback link. Example: DailyIdeasGWAPBot
DAILY_IDEAS_TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Signing key for Telegram Mini App sessions. Falls back to
# DAILY_IDEAS_INTERNAL_API_KEY and then the bot token, so sessions stay signed
# even when unset - but set it explicitly in production to keep the session
# signing key independent of the bot credential.
TELEGRAM_MINI_APP_SESSION_SECRET=

# Remote Daily Ideas endpoint used to exchange verified Mini App init data.
# Defaults to the built-in DailyIdeas URL when unset.
# DAILY_IDEAS_TELEGRAM_AUTH_URL=

# Browser-visible bot username for the Mini App launch link. Falls back to the
# server-side DAILY_IDEAS_TELEGRAM_BOT_USERNAME when unset.
NEXT_PUBLIC_DAILY_IDEAS_TELEGRAM_BOT_USERNAME=

# A manually configured direct Redis URL takes precedence over auto-provisioned
# REST integrations. Prefer rediss:// when the provider offers TLS.
# REDIS_URL=

# Upstash Redis names for workspace storage, Telegram preferences, idempotency,
# and distributed rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing Vercel KV integrations are also supported through these aliases.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Never commit a real storage value; URLs and tokens contain credentials.

# GwapScore Snapshot v1 collection. Collection stays off until the switch is
# literally "true". The collector authorizes a bearer against either key with a
# timing-safe match; the x-vercel-cron header alone is never sufficient. Vercel
# supplies CRON_SECRET for the scheduled run, the worker key covers manual and
# backfill runs. Both must be 32+ characters. Keep them server-only.
GWAPSCORE_SNAPSHOTS_ENABLED=false
CRON_SECRET=
GWAPSCORE_SNAPSHOT_WORKER_KEY=

# GWAP Developer API billing (Stripe). The webhook secret is required for
# /api/v1/developer/billing/webhook to accept any event at all - without it the
# route returns 503 and no subscription change is ever applied. The payment
# links are the hosted Stripe Checkout URLs for each paid plan.
GWAP_STRIPE_WEBHOOK_SECRET=
GWAP_STRIPE_GROWTH_PAYMENT_LINK=
GWAP_STRIPE_SCALE_PAYMENT_LINK=

# Upstream GWAP Intelligence service for GwapScore reads. Defaults to the
# built-in production URL when unset.
# GWAP_INTEL_API_URL=

# Canonical public origin used to build Telegram account-link URLs. Defaults to
# https://www.gwapspot.com when unset.
# GWAPSPOT_URL=

# Browser-visible override for the GNS public profile path. Combined with
# NEXT_PUBLIC_GNS_PROFILE_BASE_URL to build profile links.
# NEXT_PUBLIC_GNS_PROFILE_PATH_TEMPLATE=

# Search engine ownership verification tokens, rendered into the document head.
# Optional; omit both unless a property is being verified.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
